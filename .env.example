# Copy to `.env` and adjust. Never commit `.env`.

NODE_ENV=development

# --- PostgreSQL (used by docker-compose and by the API) ---
POSTGRES_USER=smartdine
POSTGRES_PASSWORD=smartdine_dev_password
POSTGRES_DB=smartdine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartdine:smartdine_dev_password@localhost:5432/smartdine?schema=public

# --- API ---
API_PORT=4000
LOG_LEVEL=info
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Set to false only when testing the Docker stack over plain http://localhost
COOKIE_SECURE=
# Per-IP limits per 15 minutes (login/register, bookings). Raise only for automated tests.
AUTH_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_MAX=30
# Outgoing mail (emailed receipts). Leave SMTP_URL empty in development: mail is logged, not sent.
# Production example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=SmartDine <no-reply@smartdine.local>
# Reservation reminders: how far ahead to remind, and how often the job runs (0 = off)
RESERVATION_REMINDER_HOURS=2
REMINDER_JOB_INTERVAL_MINUTES=5
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Web ---
# Dev server proxies /api and /socket.io to this target
VITE_API_PROXY_TARGET=http://localhost:4000
# Dev only: the sign-in page shows one-click role buttons using this password. Leave empty to hide them.
VITE_DEMO_PASSWORD=
WEB_PORT=8080
# Docker only: the public address of the site, e.g. https://dine.example.com (defaults to http://localhost:WEB_PORT).
PUBLIC_ORIGIN=

# --- Seeding ---
# Development seeds one demo account per role with this password (refused when NODE_ENV=production).
SEED_DEMO_PASSWORD=Demo-Passw0rd-2026
# Production: creates/ensures the first Owner account.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
