{
  "name": "smartdine-v2",
  "version": "2.0.0",
  "private": true,
  "description": "SmartDine V2 — restaurant & hospitality management platform",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:generate": "npm run prisma:generate -w @smartdine/api",
    "db:migrate": "npm run prisma:migrate -w @smartdine/api",
    "db:deploy": "npm run prisma:deploy -w @smartdine/api",
    "db:seed": "npm run prisma:seed -w @smartdine/api"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "bcrypt": false
  }
}
